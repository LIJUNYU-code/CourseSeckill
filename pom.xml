<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      父 POM 版本与项目一（StudentManagerSystem）完全一致，且这是硬约束：
      Spring Boot 4.1.1 要求 Java 17+，最高兼容 Java 26，本机 JDK 26 合规。
      升级 Boot 大版本会连带 Jackson 2→3、@WebMvcTest 包路径等一批破坏性变更，
      学习项目的目的是练并发，不是练升级。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>seckill-course</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>seckill-course</name>
    <description>CourseSeckill：高并发选课秒杀引擎（v0～v4 五版本性能演进）</description>

    <properties>
        <!--
          项目一用 25，这里保持一致。注意 JDK 26 运行、编译目标 25 是安全的组合；
          如果写成 26 反而会因为部分库的 class 文件版本校验更严格而无谓踩坑。
        -->
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- ========== Web / 基础 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========== 持久层 ========== -->
        <!-- MyBatis-Plus 适配 Spring Boot 4 的专用 starter（3.5.13 起提供） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!-- 分页插件必需：3.5.9+ 把 jsqlparser 相关能力拆成独立构件 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== Redis（阶段 4 起使用：库存预热 + Lua 原子扣减） ========== -->
        <!--
          阶段 1 就先引入，理由：让基础设施一次配齐，后面写业务时不用反复改 pom
          再重新下载依赖。Spring Boot 的 starter 自带 Lettuce 客户端和自动配置，
          只要 spring.data.redis.* 配好就能用 RedisTemplate / StringRedisTemplate。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ========== RabbitMQ（阶段 5 起使用：异步削峰） ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ========== 安全 / JWT ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== 接口文档 ========== -->
        <!--
          springdoc 的版本线必须与 Spring Boot 大版本对应：
            2.x 系列 → Spring Boot 3
            3.x 系列 → Spring Boot 4（本项目）
          装错版本会在启动时直接失败，不是"少几个功能"那么温和。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- ========== Lombok ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 把 @WebMvcTest 挪到了独立 starter，starter-test 里不含它 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WithMockUser 等权限测试工具 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              JDK 23 起 javac 不再从 -classpath 自动发现注解处理器，
              必须显式声明 -processorpath，否则 Lombok 的 @Data 会被静默跳过，
              表现是"编译通过但找不到 getter"这种极具迷惑性的报错。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.46</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
